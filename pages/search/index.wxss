/* search 页整体样式，风格统一为卡片式 */

.page-search {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 120rpx 32rpx 40rpx;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
}

.page-search__hd {
  margin-bottom: 32rpx;
}

.page-search__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #e6f7ec;
  margin-bottom: 24rpx;
}

.page-search__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
}

.page-search__subtitle {
  font-size: 24rpx;
  color: #6b7280;
}

.search-bar {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-bar__input-wrap {
  flex: 1;
  position: relative;
  height: 80rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
  padding: 0 64rpx 0 64rpx;
  display: flex;
  align-items: center;
}

.search-bar__icon {
  position: absolute;
  left: 24rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.search-bar__icon-img {
  width: 70%;
  height: 70%;
  display: block;
  margin: 15% auto;
}

.search-bar__input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.search-bar__input::placeholder {
  color: #9ca3af;
}

.search-bar__clear {
  position: absolute;
  right: 24rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.search-bar__button {
  flex: 0 0 180rpx;
  min-width: 140rpx;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: linear-gradient(90deg, #22c55e, #16a34a);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(34, 197, 94, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-bar__button::after {
  border: none;
}

.result-summary {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.result-list {
  flex: 1;
}

.case-card {
  display: flex;
  align-items: stretch;
  padding: 24rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.04);
}

.case-card__icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  background: #ecfdf3;
  margin-right: 20rpx;
}

.case-card__body {
  flex: 1;
}

.case-card__row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.case-card__row--top {
  margin-bottom: 12rpx;
}

.case-card__row--meta {
  font-size: 22rpx;
  color: #6b7280;
}

.case-card__code {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.case-card__badge {
  margin-left: auto;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf3;
  font-size: 22rpx;
  color: #16a34a;
}

.case-card__date {
  flex: 1;
}

.case-card__status {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  color: #b91c1c;
}

.case-card__label {
  width: 140rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.case-card__value {
  flex: 1;
  font-size: 26rpx;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.case-card__arrow {
  width: 32rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
