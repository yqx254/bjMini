/** 信息录入页样式 **/

.page-input {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 120rpx 32rpx 40rpx;
  background: #f5f7fa;
}

.page-input__hd {
  margin-bottom: 32rpx;
}

.page-input__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #e6f7ec;
  margin-bottom: 24rpx;
}

.page-input__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
}

.page-input__subtitle {
  font-size: 24rpx;
  color: #6b7280;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.04);
  margin-bottom: 24rpx;
}

.card--category {
  margin-bottom: 28rpx;
}

.card--simple {
  margin-top: 8rpx;
}

.card--code {
  margin-top: 8rpx;
}

.card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card__header--with-role {
  align-items: flex-start;
}

.card__title {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
}

.card__badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 22rpx;
  color: #16a34a;
}

.card__selector {
  min-width: 140rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__selector-text {
  font-size: 24rpx;
  color: #111827;
  margin-right: 8rpx;
  text-align: center;
}

.card__selector-arrow {
  font-size: 20rpx;
  color: #9ca3af;
}

.card__header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* card__role-* 不再使用，保留占位防止引用报错 */

.case-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.case-tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f1f5f9;
}

.case-tab--active {
  background: #ecfdf3;
  color: #16a34a;
}

.card__action {
  padding: 0 32rpx;
  height: 56rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  border-color: #22c55e;
  color: #ffffff;
  background: #22c55e;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card__action--add::after {
  border: none;
}

.person-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.person-item + .person-item {
  border-top: 2rpx solid #f3f4f6;
}

.person-item__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  margin-right: 20rpx;
  background: #f3f4f6;
  overflow: hidden;
}

.person-item__avatar-img {
  width: 70%;
  height: 70%;
  display: block;
  margin: 15% auto;
}

.person-item__body {
  flex: 1;
}

.person-item__input {
  width: 100%;
  font-size: 28rpx;
  color: #111827;
}

.person-item__input::placeholder {
  color: #9ca3af;
}

.person-item__tag {
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #111827;
}

.person-item__tag--readonly {
  background: #ecfdf3;
  color: #16a34a;
}

.person-item__delete {
  margin-left: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.person-item__delete-img {
  display: block;
}

.card__row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.card__row + .card__row {
  margin-top: 10rpx;
}

.card__row-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.card__row-content {
  flex: 1;
}

.card__row-input {
  width: 100%;
  font-size: 28rpx;
  color: #111827;
}

.card__row-input::placeholder {
  color: #9ca3af;
}

.card__row--textarea {
  align-items: flex-start;
}

.card__row-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: #111827;
}

.card__row-textarea::placeholder {
  color: #9ca3af;
}

.page-input__footer {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 32rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn--primary {
  background: linear-gradient(90deg, #22c55e, #16a34a);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(34, 197, 94, 0.35);
}

.btn--primary::after {
  border: none;
}

.btn--ghost {
  background: #ffffff;
  color: #111827;
  border: 2rpx solid #e5e7eb;
}

.btn--ghost::after {
  border: none;
}
