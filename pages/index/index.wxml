<!--index.wxml-->
<view class="page">
    <loading hidden="{{loadingHidden}}" bindchange="loadingChange" bindtap="tapLoading">
        加载中...
    </loading>
    <modal no-cancel="true" hidden="{{modalHidden}}" bindconfirm="modalConfirm" bindcancel="modalCancel">
        {{modalContent}}
    </modal>

    <view class="page__hd">
        <view class="login-header">
            <view class="login-header__logo">
                <image class="login-header__logo-img" src="/assets/img/logo.png" mode="aspectFit" />
            </view>
            <view class="login-header__title">欢迎回来</view>
            <view class="login-header__subtitle">冰鉴案件管理系统</view>
        </view>
    </view>

    <view class="page__bd">
        <view class="login-tabs">
            <!-- 只保留账号密码登录 -->
            <view class="login-tab login-tab--active">账号密码登录</view>
        </view>

        <form bindsubmit="formSubmit" bindreset="formReset">
            <view class="login-field">
                <!-- 账号图标：从 assets/icon/person.png 读取 -->
                <view class="login-field__icon login-field__icon--user">
                    <image class="login-field__icon-img" src="/assets/icon/person.png" mode="aspectFit" />
                </view>
                <input
                    type="idcard"
                    id="userName"
                    placeholder="请输入账号"
                    value="{{inputs['userName']}}"
                    bindinput="inputChange"
                />
            </view>

            <view class="login-field login-field--password">
                <!-- 密码图标：从 assets/icon/lock.png 读取 -->
                <view class="login-field__icon login-field__icon--password">
                    <image class="login-field__icon-img" src="/assets/icon/lock.png" mode="aspectFit" />
                </view>
                <input
                    password="{{!showPassword}}"
                    type="text"
                    id="password"
                    placeholder="请输入登录密码"
                    value="{{inputs['password']}}"
                    bindinput="inputChange"
                />
                <!-- 密码显隐切换 -->
                <view class="login-field__password-toggle" bindtap="togglePasswordVisible">
                    <image class="login-field__password-toggle-icon" src="/assets/icon/visibility.png"/>
                </view>
            </view>

            <view class="btn-area">
                <view class="button-wrapper">
                    <button type="primary" formType="submit" class="primary">登录</button>
                </view>
            </view>
        </form>
    </view>
</view>
